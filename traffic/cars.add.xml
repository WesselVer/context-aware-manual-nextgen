<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO vehicle types for the traffic (sumo_traffic.py). Each id is the CARLA blueprint the
     bridge spawns for it; sizes are the blueprints' bounding boxes on CARLA 1.0 (width at most
     2.1 m: the boxes include the mirrors). How the drivers drive is from Coupled CARLA
     (github.com/bazilinskyy/coupled-carla, drivers.py, MIT): SUMO's Extended Intelligent Driver
     Model, a comfortable 3.4 m/s2 braking (AASHTO), a 1.2 s time gap and 2 m minimum gap (Treiber
     and Kesting), nobody forcing a way through a junction, and each driver's speed spread round
     the limit (speedFactor). The probabilities make a mix of everyday cars, a few sports cars, a
     van and a truck. -->
<additional>
  <vTypeDistribution id="cars">
    <vType id="vehicle.kia.niro" vClass="passenger" probability="1.5" carFollowModel="EIDM" speedFactor="normc(1.0,0.1,0.8,1.2)" accel="2.6" decel="3.4" emergencyDecel="8.0" apparentDecel="3.4" tau="1.2" minGap="2.0" jmIgnoreFoeProb="0" impatience="0" length="4.45" width="1.90" height="1.60"/>
