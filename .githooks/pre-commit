#!/bin/sh
# Stops a commit that holds participant data, even one added with git add -f.
# Turn on once per clone: git config core.hooksPath .githooks
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E -i '(^|/)(study_data|_out|session-[^/]*|P[0-9]+)/|\.(csv|rec|log)$|(^|/)(drive\.json|report\.html|drive-[^/]*|events-[^/]*)$')
if [ -n "$bad" ]; then
    echo "Commit stopped: these look like participant data and must not go to GitHub:" >&2
    echo "$bad" >&2
    exit 1
fi
